<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sunflower Gimbal Tracker - Join the Solar Revolution</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=Work+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        :root {
            --sunflower-gold: #FFB81C;
            --deep-gold: #E89C31;
            --forest-green: #2C5F2D;
            --earth-brown: #6B4423;
            --sky-blue: #87CEEB;
            --cream: #FFF8E7;
            --dark: #1a1a1a;
        }
        
        body {
            font-family: 'Work Sans', sans-serif;
            line-height: 1.6;
            color: var(--dark);
            background: var(--cream);
            overflow-x: hidden;
        }
        
        /* Organic flowing header */
        header {
            position: relative;
            height: 100vh;
            background: linear-gradient(135deg, var(--sunflower-gold) 0%, var(--deep-gold) 100%);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        /* Animated sunflower petals background */
        .petals {
            position: absolute;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }
        
        .petal {
            position: absolute;
            width: 200px;
            height: 200px;
            background: radial-gradient(ellipse at center, rgba(255, 184, 28, 0.3), transparent);
            border-radius: 50% 0 50% 0;
            animation: float 20s infinite ease-in-out;
            opacity: 0.6;
        }
        
        .petal:nth-child(1) { top: 10%; left: 10%; animation-delay: 0s; }
        .petal:nth-child(2) { top: 60%; left: 80%; animation-delay: 3s; }
        .petal:nth-child(3) { top: 80%; left: 20%; animation-delay: 6s; }
        .petal:nth-child(4) { top: 30%; left: 70%; animation-delay: 9s; }
        
        @keyframes float {
            0%, 100% { transform: translate(0, 0) rotate(0deg); }
            33% { transform: translate(30px, -30px) rotate(120deg); }
            66% { transform: translate(-20px, 20px) rotate(240deg); }
        }
        
        .hero-content {
            position: relative;
            z-index: 10;
            text-align: center;
            max-width: 900px;
            padding: 2rem;
            animation: fadeInUp 1s ease-out;
        }
        
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        h1 {
            font-family: 'Playfair Display', serif;
            font-size: 5rem;
            font-weight: 900;
            color: white;
            text-shadow: 3px 3px 20px rgba(0,0,0,0.3);
            margin-bottom: 1rem;
            letter-spacing: -2px;
        }
        
        .tagline {
            font-size: 1.5rem;
            color: var(--forest-green);
            font-weight: 500;
            margin-bottom: 2rem;
            text-shadow: 1px 1px 5px rgba(255,255,255,0.5);
        }
        
        .hero-stats {
            display: flex;
            justify-content: center;
            gap: 3rem;
            margin-top: 2rem;
        }
        
        .stat {
            text-align: center;
        }
        
        .stat-number {
            font-size: 3rem;
            font-weight: 700;
            color: white;
            display: block;
        }
        
        .stat-label {
            font-size: 0.9rem;
            color: var(--forest-green);
            text-transform: uppercase;
            letter-spacing: 2px;
        }
        
        /* Navigation */
        nav {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 1.5rem 3rem;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            z-index: 1000;
            box-shadow: 0 2px 20px rgba(0,0,0,0.1);
            display: flex;
            justify-content: space-between;
            align-items: center;
            opacity: 0;
            animation: slideDown 0.5s ease-out 0.5s forwards;
        }
        
        @keyframes slideDown {
            to {
                opacity: 1;
            }
        }
        
        .logo {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--deep-gold);
        }
        
        .nav-links {
            display: flex;
            gap: 2rem;
            list-style: none;
        }
        
        .nav-links a {
            text-decoration: none;
            color: var(--dark);
            font-weight: 500;
            transition: color 0.3s;
        }
        
        .nav-links a:hover {
            color: var(--deep-gold);
        }
        
        /* CTA Button */
        .cta-btn {
            display: inline-block;
            padding: 1.2rem 3rem;
            background: var(--forest-green);
            color: white;
            text-decoration: none;
            border-radius: 50px;
            font-weight: 600;
            font-size: 1.1rem;
            transition: all 0.3s;
            box-shadow: 0 5px 20px rgba(44, 95, 45, 0.4);
        }
        
        .cta-btn:hover {
            background: #1f4520;
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(44, 95, 45, 0.6);
        }
        
        /* Sections */
        section {
            padding: 6rem 3rem;
            max-width: 1200px;
            margin: 0 auto;
        }
        
        h2 {
            font-family: 'Playfair Display', serif;
            font-size: 3.5rem;
            color: var(--earth-brown);
            margin-bottom: 3rem;
            text-align: center;
        }
        
        /* Problem & Solution */
        .problem-solution {
            background: white;
            border-radius: 30px;
            padding: 4rem;
            box-shadow: 0 10px 50px rgba(0,0,0,0.1);
            margin-bottom: 4rem;
        }
        
        .split-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            margin-top: 3rem;
        }
        
        .content-box {
            padding: 2rem;
            border-radius: 20px;
        }
        
        .problem-box {
            background: linear-gradient(135deg, #fee 0%, #fdd 100%);
            border-left: 5px solid #c33;
        }
        
        .solution-box {
            background: linear-gradient(135deg, #efe 0%, #dfd 100%);
            border-left: 5px solid var(--forest-green);
        }
        
        h3 {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            margin-bottom: 1rem;
        }
        
        /* Product Showcase */
        .product-showcase {
            background: var(--forest-green);
            color: white;
            border-radius: 30px;
            padding: 5rem;
            position: relative;
            overflow: hidden;
        }
        
        .product-showcase::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, rgba(255,255,255,0.1), transparent);
        }
        
        .features-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 3rem;
            margin-top: 3rem;
        }
        
        .feature {
            text-align: center;
            padding: 2rem;
            background: rgba(255,255,255,0.1);
            border-radius: 20px;
            transition: transform 0.3s;
        }
        
        .feature:hover {
            transform: translateY(-10px);
        }
        
        .feature-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
        }
        
        .feature-value {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--sunflower-gold);
            display: block;
            margin-bottom: 0.5rem;
        }
        
        /* Crowdfunding Section */
        .crowdfunding {
            background: linear-gradient(135deg, var(--sunflower-gold) 0%, var(--deep-gold) 100%);
            border-radius: 30px;
            padding: 5rem;
            text-align: center;
            box-shadow: 0 15px 60px rgba(232, 156, 49, 0.4);
        }
        
        .crowdfunding h2 {
            color: white;
        }
        
        .funding-progress {
            max-width: 600px;
            margin: 3rem auto;
        }
        
        .progress-bar-container {
            background: rgba(255,255,255,0.3);
            height: 40px;
            border-radius: 20px;
            overflow: hidden;
            margin-bottom: 2rem;
            position: relative;
        }
        
        .progress-bar {
            background: var(--forest-green);
            height: 100%;
            width: 0%;
            border-radius: 20px;
            transition: width 2s ease-out;
            animation: fillBar 2s ease-out 1s forwards;
        }
        
        @keyframes fillBar {
            to {
                width: 28.3%; /* £8,500 / £30,000 */
            }
        }
        
        .progress-label {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: white;
            font-weight: 700;
            font-size: 1.1rem;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.3);
        }
        
        .funding-stats {
            display: flex;
            justify-content: space-around;
            margin-bottom: 3rem;
        }
        
        .funding-stat {
            text-align: center;
        }
        
        .funding-stat-value {
            font-size: 3rem;
            font-weight: 700;
            color: white;
            display: block;
        }
        
        .funding-stat-label {
            color: var(--forest-green);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        /* Investment Tiers */
        .investment-tiers {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
            margin-top: 3rem;
        }
        
        .tier {
            background: white;
            border-radius: 20px;
            padding: 2.5rem;
            text-align: center;
            transition: all 0.3s;
            border: 3px solid transparent;
        }
        
        .tier:hover {
            transform: scale(1.05);
            border-color: var(--forest-green);
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        }
        
        .tier-name {
            font-family: 'Playfair Display', serif;
            font-size: 1.8rem;
            color: var(--earth-brown);
            margin-bottom: 1rem;
        }
        
        .tier-amount {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--forest-green);
            margin-bottom: 1.5rem;
        }
        
        .tier-perks {
            list-style: none;
            text-align: left;
            margin-bottom: 2rem;
        }
        
        .tier-perks li {
            padding: 0.5rem 0;
            color: #333;
        }
        
        .tier-perks li::before {
            content: "✓ ";
            color: var(--forest-green);
            font-weight: bold;
            margin-right: 0.5rem;
        }
        
        .tier-btn {
            display: block;
            width: 100%;
            padding: 1rem;
            background: var(--forest-green);
            color: white;
            text-decoration: none;
            border-radius: 10px;
            font-weight: 600;
            transition: background 0.3s;
        }
        
        .tier-btn:hover {
            background: #1f4520;
        }
        
        .featured-tier {
            background: linear-gradient(135deg, #fff8e7 0%, #ffe4b5 100%);
            border-color: var(--deep-gold);
            position: relative;
            overflow: hidden;
        }
        
        .featured-badge {
            position: absolute;
            top: 20px;
            right: -30px;
            background: var(--deep-gold);
            color: white;
            padding: 5px 40px;
            transform: rotate(45deg);
            font-size: 0.8rem;
            font-weight: 700;
        }
        
        /* Why Invest */
        .why-invest {
            background: white;
            border-radius: 30px;
            padding: 4rem;
            margin-top: 4rem;
        }
        
        .reasons-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 3rem;
            margin-top: 3rem;
        }
        
        .reason {
            display: flex;
            gap: 1.5rem;
            align-items: flex-start;
        }
        
        .reason-icon {
            font-size: 2.5rem;
            flex-shrink: 0;
        }
        
        .reason-content h4 {
            font-size: 1.3rem;
            margin-bottom: 0.5rem;
            color: var(--earth-brown);
        }
        
        /* Impact Section */
        .impact {
            background: var(--sky-blue);
            border-radius: 30px;
            padding: 5rem;
            margin-top: 4rem;
            text-align: center;
        }
        
        .impact-stats {
            display: flex;
            justify-content: space-around;
            margin-top: 3rem;
        }
        
        .impact-stat {
            text-align: center;
        }
        
        .impact-number {
            font-size: 4rem;
            font-weight: 700;
            color: white;
            display: block;
            text-shadow: 2px 2px 10px rgba(0,0,0,0.2);
        }
        
        .impact-label {
            color: var(--forest-green);
            font-weight: 600;
            font-size: 1.1rem;
        }
        
        /* Team Section */
        .team {
            text-align: center;
        }
        
        .founder {
            max-width: 600px;
            margin: 3rem auto;
            padding: 3rem;
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        }
        
        .founder-name {
            font-family: 'Playfair Display', serif;
            font-size: 2rem;
            color: var(--earth-brown);
            margin-bottom: 0.5rem;
        }
        
        .founder-title {
            color: var(--deep-gold);
            font-weight: 600;
            margin-bottom: 1.5rem;
        }
        
        .contact-info {
            display: flex;
            justify-content: center;
            gap: 2rem;
            margin-top: 2rem;
            flex-wrap: wrap;
        }
        
        .contact-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: var(--forest-green);
            font-weight: 500;
        }
        
        /* Footer */
        footer {
            background: var(--dark);
            color: white;
            text-align: center;
            padding: 3rem;
            margin-top: 4rem;
        }
        
        /* Responsive */
        @media (max-width: 968px) {
            h1 {
                font-size: 3rem;
            }
            
            .split-content,
            .features-grid,
            .investment-tiers,
            .reasons-grid {
                grid-template-columns: 1fr;
            }
            
            .hero-stats {
                flex-direction: column;
                gap: 2rem;
            }
            
            section {
                padding: 4rem 2rem;
            }
        }
        
        /* Scroll animations */
        .fade-in {
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.8s, transform 0.8s;
        }
        
        .fade-in.visible {
            opacity: 1;
            transform: translateY(0);
        }
    </style>
</head>
